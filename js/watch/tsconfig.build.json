{
	// Build-only variant of tsconfig.json that keeps tests and their fixtures out of dist/, so they
	// are neither published nor discovered by `bun test` at the package root.
	// `tsc --noEmit` still uses tsconfig.json, so they stay type-checked.
	"extends": "./tsconfig.json",
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/audio/fake.ts", "src/audio/playout/fixture.ts"]
}
